# Public by definition (PRD 13.5). Safe in a client bundle.
# Read by all three client factories in src/lib/supabase/, so `npm test` needs
# them in .env.test as well — not only the bare test-only names further down.
# Not needed to run `npm run build` (every /admin route is forced dynamic —
# see src/app/(admin)/admin/layout.tsx), but required at runtime for every
# /admin route to work at all, on Vercel as both a build and a runtime env
# var, and locally in .env.local for `npm run dev`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin of the deployed site, e.g. https://askhub.example.org.
# Used for canonical URLs and the share pop-up's link. Empty locally, which
# yields root-relative URLs — correct for dev, wrong for a shared link.
NEXT_PUBLIC_SITE_URL=

# Server-only. Bypasses RLS entirely. Must never reach a client bundle,
# and must never be given a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only, optional. A secret string mixed into the SHA-256 of a visitor's
# IP address before the public suggestion form's rate limit stores the hash
# (src/lib/actions/suggestions.ts; the address itself is never stored). Any
# long random value. When unset, no hash is stored and the per-network limit
# does not apply; the per-address and global limits still hold.
SUBMISSION_IP_PEPPER=

# Test-only, read directly by test helpers and tests/smoke.test.ts from
# .env.test. Point these at the local CLI stack, never at production.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Copy to .env.local for `npm run dev`, and to .env.test for `npm test`.
# .env.test needs every name in this file: the NEXT_PUBLIC_ pair above, the
# service_role key, and the bare test-only pair.
# Local values come from `npx supabase status`.
# Both files are gitignored. This template carries names only.
